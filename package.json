    "@stellar/stellar-sdk": "^14.1.1",
    "axios": "^1.20.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
